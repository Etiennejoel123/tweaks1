<UserControl x:Class="StrohmayerTweaks.UI.Views.DashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Style="{StaticResource FadeIn}" Margin="32,28,32,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="Dashboard" Style="{StaticResource Title}"/>
            <TextBlock Text="An overview of your PC and what Strohmayer Tweaks has changed." Style="{StaticResource Muted}" Margin="0,4,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}" Margin="0,0,0,16" BorderBrush="{StaticResource PurpleBrush}">
                    <StackPanel>
                        <TextBlock Text="Compatibility" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Compatibility}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <ItemsControl ItemsSource="{Binding Cards}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Width="270" Margin="0,0,16,16">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Muted}" FontSize="12"/>
                                    <TextBlock Text="{Binding Value}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,4"/>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
