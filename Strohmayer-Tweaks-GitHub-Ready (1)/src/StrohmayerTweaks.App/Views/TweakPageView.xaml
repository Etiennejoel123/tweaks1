<UserControl x:Class="StrohmayerTweaks.UI.Views.TweakPageView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Style="{StaticResource FadeIn}" Margin="32,28,32,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Title}"/>
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/>
                                        <Border Style="{StaticResource Badge}"><TextBlock Text="{Binding RiskText}" FontSize="11" Foreground="{StaticResource MutedBrush}"/></Border>
                                        <Border Style="{StaticResource Badge}"><TextBlock Text="{Binding AdminText}" FontSize="11" Foreground="{StaticResource MutedBrush}"/></Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                                    <TextBlock Text="{Binding Details}" Style="{StaticResource Muted}" FontFamily="Consolas" FontSize="11" Margin="0,8,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding StateText}" HorizontalAlignment="Right" Foreground="{StaticResource BlueBrush}"/>
                                    <Button Content="{Binding ActionText}" Command="{Binding ToggleCommand}" Style="{StaticResource AccentButton}" MinWidth="110" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
