<UserControl x:Class="StrohmayerTweaks.UI.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Style="{StaticResource FadeIn}" Margin="32,28,32,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="Settings" Style="{StaticResource Title}"/>
            <TextBlock Text="Permissions, compatibility and where your data is stored." Style="{StaticResource Muted}" Margin="0,4,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Restart as administrator" Style="{StaticResource AccentButton}" Command="{Binding ElevateCommand}" IsEnabled="{Binding CanElevate}" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="Permissions" FontWeight="SemiBold" Foreground="{StaticResource BlueBrush}"/>
                            <TextBlock Text="{Binding AdminStatus}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Compatibility" FontWeight="SemiBold" Foreground="{StaticResource BlueBrush}"/>
                        <TextBlock Text="{Binding Compatibility}" Margin="0,6,0,0"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0">
                            <Run Text=".NET runtime "/><Run Text="{Binding RuntimeText, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Open logs" Style="{StaticResource GhostButton}" Command="{Binding OpenLogsCommand}" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="Log files" FontWeight="SemiBold" Foreground="{StaticResource BlueBrush}"/>
                            <TextBlock Text="{Binding LogPath}" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Open backups" Style="{StaticResource GhostButton}" Command="{Binding OpenBackupsCommand}" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="Backups" FontWeight="SemiBold" Foreground="{StaticResource BlueBrush}"/>
                            <TextBlock Text="{Binding BackupPath}" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
