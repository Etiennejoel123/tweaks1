<UserControl x:Class="StrohmayerTweaks.UI.Views.RestoreView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Style="{StaticResource FadeIn}" Margin="32,28,32,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,20">
            <Button DockPanel.Dock="Right" Content="Refresh" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" VerticalAlignment="Center"/>
            <StackPanel>
                <TextBlock Text="Restore Center" Style="{StaticResource Title}"/>
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                           Text="Every tweak saves the original registry values here before it is applied. Restoring puts those values back."/>
            </StackPanel>
        </DockPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="No backups yet. A backup is created automatically the first time you apply a tweak." Style="{StaticResource Muted}"/>
                </Border>
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding TweakName}" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0">
                                            <Run Text="{Binding Created, Mode=OneWay}"/><Run Text="  |  "/><Run Text="{Binding StatusText, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontFamily="Consolas" FontSize="11" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Restore" Command="{Binding RestoreCommand}" Style="{StaticResource AccentButton}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
