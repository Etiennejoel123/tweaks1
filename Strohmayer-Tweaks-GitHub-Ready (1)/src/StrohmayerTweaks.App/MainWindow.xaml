<Window x:Class="StrohmayerTweaks.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Strohmayer Tweaks" Width="1280" Height="800" MinWidth="1000" MinHeight="640"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="24,28,24,20">
                    <TextBlock Text="STROHMAYER" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PurpleBrush}"/>
                    <TextBlock Text="TWEAKS" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BlueBrush}"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding VersionText}" Margin="24,12" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                <ListBox ItemsSource="{Binding NavItems}" SelectedItem="{Binding Selected}"
                         ItemContainerStyle="{StaticResource NavItem}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16" Width="30" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                <TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Background="#2A2110" BorderBrush="{StaticResource WarnBrush}" BorderThickness="0,0,0,1" Padding="20,10"
                    Visibility="{Binding ShowAdminBanner, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Restart as administrator" Style="{StaticResource GhostButton}" Command="{Binding RestartAsAdminCommand}"/>
                    <TextBlock VerticalAlignment="Center" Foreground="{StaticResource WarnBrush}"
                               Text="Running without administrator rights. Machine-wide tweaks and service control are locked."/>
                </DockPanel>
            </Border>
            <ContentControl Grid.Row="1" Content="{Binding Selected.ViewModel}"/>
        </Grid>
    </Grid>
</Window>
